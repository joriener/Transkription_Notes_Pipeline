# Languages with confirmed whisperx alignment model support.
SUPPORTED_LANGUAGES = {"en", "de", "fr", "es", "it", "ja", "zh", "nl", "uk", "pt"}


def build_initial_prompt(language: str | None = None) -> str:
    """
    Build a compact initial_prompt string for whisperx from the vocabulary.
    Joins all terms with comma-space separation. Whisper processes this as
    preceding spoken context, biasing its decoder towards the listed terms.

    Args:
        language: "en", "de", or None (returns English prompt as default).

    Returns:
        A plain string of comma-separated terms, capped at ~180 words to
        stay within Whisper's 224-token context window.
    """
    if language and language.lower().startswith("de"):
        vocab = VOCAB_DE
    else:
        vocab = VOCAB_EN

    terms: list[str] = []
    for category_terms in vocab.values():
        terms.extend(category_terms)

    # Deduplicate while preserving order
    seen: set[str] = set()
    unique: list[str] = []
    for t in terms:
        if t not in seen:
            seen.add(t)
            unique.append(t)

    prompt = ", ".join(unique)
    words = prompt.split()
    if len(words) > 180:
        truncated = " ".join(words[:180])
        last_comma = truncated.rfind(",")
        prompt = truncated[:last_comma] if last_comma > 0 else truncated

    return prompt


if __name__ == "__main__":
    # Quick test: print both prompts and word counts
    for lang in ("en", "de"):
        p = build_initial_prompt(lang)
        print(f"\n--- {lang.upper()} prompt ({len(p.split())} words) ---")
        print(p[:300], "...")
