# Secrets
keys.cfg

# Personal vocabulary extensions (keep vocabulary.py.example tracked instead)
vocabulary.py

# Runtime data
*.db
*.db-shm
*.db-wal
*.db-journal
__pycache__/
*.pyc
logs/

# Persisted GUI settings (task #71): per-machine last-used values, not source
gui_state.json

# Generated outputs (transcripts, notes, slide reports) - stay next to source media,
# which normally lives outside this repo, but ignore them if ever created here.
*_transcript_speakers.txt
*_text.txt
*_transcript.srt
*_segments.json
*_notes.txt
*_notes.html
*_notes.pdf
*_notes.docx
*_slides/
output/
batch_log_*.txt
batch_folder_log_*.txt
notes_batch_log_*.txt

# Sample/test media
*.mp4
*.mp3
*.wav
*.m4a
*.mkv
*.mov

# Corruption-recovery backups (see 2026-07-02 db incident), not source
*.corrupt-backup

# Templates tab (task #77): automatic pre-Save/Delete backups of prompt
# templates, not source - the tracked prompts/*.md files are.
prompts/_backup/

# Bundled ffmpeg/ffplay/ffprobe binaries (config.py's _BUNDLED_FFMPEG_DIR).
# Fetched by install.ps1, not stored in git: the three .exe files are ~87 MB
# each (~251 MB total), and the gyan.dev essentials build is GPL v3, so this
# repository does not redistribute it. config.get_ffmpeg_path() falls back to
# ffmpeg on PATH, then to None, when the bundled copy is absent.
ffmpeg/

# Scratch output from redirected manual pytest runs (not produced by the
# tests themselves - those write only under pytest's tmp_path).
_t*.txt
_pytest_out*.txt
.pytest_cache/
